#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
REPO="${FERRAXIS_GH_REPO:-darkstardevx/ferraxis}"
RUN_ID="${1:-}"

command -v gh >/dev/null 2>&1 || {
  echo "error: gh is required" >&2
  exit 1
}

if [[ -z "$RUN_ID" ]]; then
  branch="$(git branch --show-current)"
  sha="$(git rev-parse HEAD)"
  RUN_ID="$(
    gh run list --repo "$REPO" --branch "$branch" --limit 20 --json databaseId,headSha       -q ".[] | select(.headSha == \"$sha\") | .databaseId" | head -n1
  )"
fi

[[ -n "$RUN_ID" ]] || {
  echo "error: no workflow run found for current HEAD" >&2
  exit 1
}

gh run watch "$RUN_ID" --repo "$REPO" --exit-status
gh run view "$RUN_ID" --repo "$REPO" --json url,headSha,conclusion   -q '"CI run: \(.url)\nHEAD:   \(.headSha)\nResult: \(.conclusion)"'

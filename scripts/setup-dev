#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

command -v rustup >/dev/null 2>&1 || {
  echo "error: rustup is required" >&2
  exit 1
}

echo "==> stable toolchain"
rustup toolchain install stable --profile minimal --component rustfmt --component clippy

echo "==> MSRV toolchain"
rustup toolchain install 1.85.0 --profile minimal

./scripts/install-hooks

missing=()
for command in gh npx lychee shellcheck; do
  command -v "$command" >/dev/null 2>&1 || missing+=("$command")
done

if [[ "${#missing[@]}" -gt 0 ]]; then
  echo "Workflow tools still missing: ${missing[*]}"
  echo "Install them before running the full gate."
else
  echo "Ferraxis development environment is ready."
fi
